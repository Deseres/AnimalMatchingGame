                        Clicked="AnimalButton_Clicked"/>
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="#ADD8E6" BorderColor="#000000" BorderWidth="1"
                        Clicked="AnimalButton_Clicked"/>
